datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LocationType {
  FACTORY
  RETAIL_BRANCH
  TRANSIT_HUB
}

enum RoleType {
  SUPER_ADMIN
  OWNER
  ADMIN
  FACTORY_MANAGER
  PRODUCTION_MANAGER
  BRANCH_MANAGER
  POS_OPERATOR
  KDS_OPERATOR
  LOGISTICS_COORDINATOR
  DRIVER
  ACCOUNTANT
  CRM_AGENT
  HR
  CHEF
}

enum UserScope {
  GLOBAL
  FACTORY
  BRANCH
  ASSIGNED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  POINTS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPIRE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

model Organization {
  id                String                   @id @default(uuid()) @db.Uuid
  code              String                   @unique // e.g. CC001
  name              String                   @unique
  taxIdentifier     String?
  website           String?
  logoUrl           String?
  branches          Branch[]
  taxRules          TaxRule[]
  unitOfMeasures    UnitOfMeasure[]
  categories        Category[]
  brands            Brand[]
  suppliers         Supplier[]
  productAttributes ProductAttribute[]
  recipeMasters     RecipeMaster[]
  numberSeries      NumberSeries[]
  products          Product[]
  productVariants   ProductVariant[]
  departments       Department[]
  designations      Designation[]
  employees         Employee[]
  accounts          Account[]
  fiscalYears       FiscalYear[]
  journalEntries    JournalEntry[]
  expenses          Expense[]
  expenseCategories ExpenseCategoryMapping[]
  // Master audit fields
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  deletedBy         String?                  @db.Uuid
  salesOrders       SalesOrder[]
  dispatches        Dispatch[]
}

model Branch {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  organization      Organization      @relation(fields: [organizationId], references: [id])
  name              String            @unique
  type              LocationType
  address           String
  phone             String?
  gstin             String?
  registers         POSRegister[]
  users             User[]
  storageLocations  StorageLocation[]
  assignedEmployees Employee[]        @relation("EmployeeAssignedBranch")

  // Sprint 3 Inventory relations
  stockBalances StockBalance[]
  wastageLogs   WastageLog[]           @relation("WastageBranch")
  transfersFrom StockTransfer[]        @relation("TransferFrom")
  transfersTo   StockTransfer[]        @relation("TransferTo")
  txFrom        InventoryTransaction[] @relation("TxFromLocation")
  txTo          InventoryTransaction[] @relation("TxToLocation")

  // Sprint 5 Production relations
  productionOrders ProductionOrder[]

  // Sprint 6 Procurement relations
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  grns                 GoodsReceiptNote[]

  // Sprint 7 Sales & Commerce relations
  salesOrders           SalesOrder[]
  promotions            Promotion[]
  reservations          InventoryReservation[]
  posShifts             PosShift[]
  posOfflineSyncRecords PosOfflineSyncRecord[]
  assignedCustomers     Customer[]             @relation("CustomerAssignedBranch")
  journalLines          JournalEntryLine[]
  expenses              Expense[]

  // Logistics reverse relations (Phase 1 fix)
  dispatchesFrom Dispatch[] @relation("DispatchFrom")
  dispatchesTo   Dispatch[] @relation("DispatchTo")

  // Master audit fields
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
}

model POSRegister {
  id               String @id @default(uuid()) @db.Uuid
  branchId         String @db.Uuid
  branch           Branch @relation(fields: [branchId], references: [id])
  name             String // e.g. "Register 1"
  deviceIdentifier String @unique // MAC or Device UUID

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique // e.g. "SUPER_ADMIN", "FACTORY_MANAGER"
  type            RoleType
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  approvalSteps   ApprovalStep[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique // e.g. "users:read", "inventory:write"
  description     String?
  rolePermissions RolePermission[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @db.Uuid // For GLOBAL scope users not tied to a branch
  branchId       String?        @db.Uuid // Nullable: GLOBAL users have no branch
  branch         Branch?        @relation(fields: [branchId], references: [id])
  username       String         @unique
  passwordHash   String
  fullName       String
  email          String?
  phone          String?
  scope          UserScope      @default(BRANCH)
  userRoles      UserRole[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  loginHistories LoginHistory[]

  // Account lock fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Status
  status UserStatus @default(ACTIVE)

  // Master audit fields
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  passwordResetTokens PasswordResetToken[]
  employee            Employee?
  dispatches          Dispatch[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String?  @unique
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  device    String?
  status    String // SUCCESS, FAILED
  timestamp DateTime @default(now())
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  module      String // e.g. "Inventory", "Authentication"
  entity      String // e.g. "Product", "User"
  entityId    String      @db.Uuid
  action      AuditAction
  performedBy String      @db.Uuid // User.id
  branchId    String      @db.Uuid // Branch.id
  ip          String?
  device      String?
  before      Json? // JSON Snapshot before change
  after       Json? // JSON Snapshot after change
  timestamp   DateTime    @default(now())
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  message   String
  stack     String?
  path      String?
  module    String?
  userId    String?  @db.Uuid
  timestamp DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel
  message   String
  context   String?
  timestamp DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String // e.g., "UNAUTHORIZED_ACCESS", "BRUTE_FORCE_DETECTED"
  details   String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "tax.gst_rate"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model BranchSetting {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  key       String // e.g. "receipt.header"
  value     String
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String?  @db.Uuid // If null, applies globally
  key       String // e.g. "CUSTOM_CAKE"
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  name      String // e.g., "order.created"
  type      String // DOMAIN, INTEGRATION, NOTIFICATION
  payload   Json
  createdAt DateTime @default(now())
}

model EventQueue {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  status    String // PENDING, PROCESSING, COMPLETED, FAILED
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationQueue {
  id        String   @id @default(uuid()) @db.Uuid
  recipient String // WhatsApp phone number, email, or device register
  type      String // WHATSAPP, EMAIL, SMS, PUSH
  content   String
  status    String // PENDING, SENT, FAILED
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────
// MASTER DATA (SPRINT 2)
// ────────────────────────────────────────────────────────────────────────

model TaxRule {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String // e.g., "GST 18%"
  rate           Decimal        @db.Decimal(5, 2) // e.g., 18.00
  hsn            String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isDefault      Boolean        @default(false)
  components     TaxComponent[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  products  Product[]

  @@unique([organizationId, name])
}

model UnitOfMeasure {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // e.g., "Kilograms"
  symbol         String // e.g., "kg"

  baseUnitId       String?         @db.Uuid
  baseUnit         UnitOfMeasure?  @relation("UomConversion", fields: [baseUnitId], references: [id])
  childUnits       UnitOfMeasure[] @relation("UomConversion")
  conversionFactor Decimal?        @db.Decimal(10, 4) // Multiplier
  allowDecimal     Boolean         @default(true)

  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  deletedBy   String?      @db.Uuid
  products    Product[]
  productUOMs ProductUOM[]

  @@unique([organizationId, name])
  @@unique([organizationId, symbol])
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentId       String?      @db.Uuid
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  name           String
  description    String?
  slug           String?
  icon           String?
  imageUrl       String?
  color          String?
  displayOrder   Int          @default(0)
  showInPos      Boolean      @default(true)
  showInStore    Boolean      @default(true)

  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  deletedBy  String?     @db.Uuid
  products   Product[]
  promotions Promotion[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
}

model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  products  Product[]

  @@unique([organizationId, name])
}

model Supplier {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  organization      Organization       @relation(fields: [organizationId], references: [id])
  code              String
  name              String
  contactPerson     String?
  email             String?
  phone             String?
  address           String?
  gst               String? // Replaces taxId
  pan               String?
  creditLimit       Decimal?           @db.Decimal(12, 2)
  paymentTerms      String?
  bankDetails       Json?
  openingBalance    Decimal            @default(0) @db.Decimal(12, 2)
  preferredSupplier Boolean            @default(false)
  status            String             @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  items             SupplierItem[]
  purchaseOrders    PurchaseOrder[]
  grns              GoodsReceiptNote[]
  expenses          Expense[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

model StorageLocation {
  id              String            @id @default(uuid()) @db.Uuid
  branchId        String            @db.Uuid
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentId        String?           @db.Uuid
  parent          StorageLocation?  @relation("StorageHierarchy", fields: [parentId], references: [id])
  children        StorageLocation[] @relation("StorageHierarchy")
  name            String
  locationCode    String?
  description     String?
  temperatureType String? // e.g., AMBIENT, REFRIGERATED, FROZEN
  capacity        String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([branchId, name])
}

// ────────────────────────────────────────────────────────────────────────
// SPRINT 2.5 : ADVANCED MASTER DATA
// ────────────────────────────────────────────────────────────────────────

// 1. Product Attributes
model ProductAttribute {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id])
  name           String // e.g., Flavor, Size
  type           String // TEXT, COLOR, NUMBER
  values         ProductAttributeValue[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, name])
}

model ProductAttributeValue {
  id          String           @id @default(uuid()) @db.Uuid
  attributeId String           @db.Uuid
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  deletedBy                String?                   @db.Uuid
  productVariantAttributes ProductVariantAttribute[]

  @@unique([attributeId, value])
}

// 2. Recipe Master
model RecipeMaster {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  yieldQuantity  Decimal      @db.Decimal(10, 4)
  uomId          String       @db.Uuid
  variantId      String?      @db.Uuid // Linking recipe yield to a specific variant (nullable during migration)

  versions RecipeVersion[]
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, name])
}

model RecipeVersion {
  id                String             @id @default(uuid()) @db.Uuid
  recipeId          String             @db.Uuid
  recipe            RecipeMaster       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  versionNumber     String
  instructions      String?
  totalCostEstimate Decimal?           @db.Decimal(12, 2)
  ingredients       RecipeIngredient[]
  productionOrders  ProductionOrder[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([recipeId, versionNumber])
}

model RecipeIngredient {
  id              String         @id @default(uuid()) @db.Uuid
  recipeVersionId String         @db.Uuid
  recipeVersion   RecipeVersion  @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  variantId       String         @db.Uuid // Ingredient must be a real tracked variant
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Decimal        @db.Decimal(10, 4)
  uomId           String         @db.Uuid
  notes           String?
  costEstimate    Decimal?       @db.Decimal(12, 2)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
}

// 3. Supplier Pricing
model SupplierItem {
  id            String         @id @default(uuid()) @db.Uuid
  supplierId    String         @db.Uuid
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variantId     String         @db.Uuid // Must reference a real variant
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  itemCode      String
  purchasePrice Decimal        @db.Decimal(12, 2)
  leadTimeDays  Int            @default(0)
  moq           Decimal        @default(1) @db.Decimal(10, 4)
  notes         String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([supplierId, itemCode])
}

// 4. Tax Components
model TaxComponent {
  id            String  @id @default(uuid()) @db.Uuid
  taxRuleId     String  @db.Uuid
  taxRule       TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  componentName String // e.g., CGST, SGST
  rate          Decimal @db.Decimal(5, 2)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([taxRuleId, componentName])
}

// 6. Number Series
model NumberSeries {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  documentType   String // e.g., SO, INV, PO
  prefix         String
  currentNumber  Int          @default(0)
  length         Int          @default(6)
  suffix         String?
  branchId       String?      @db.Uuid

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, documentType, branchId])
}

// 7. Approval Workflow
model ApprovalWorkflow {
  id          String         @id @default(uuid()) @db.Uuid
  moduleName  String         @unique // e.g., Wastage, PO
  description String?
  steps       ApprovalStep[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
}

model ApprovalStep {
  id             String           @id @default(uuid()) @db.Uuid
  workflowId     String           @db.Uuid
  workflow       ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder      Int
  requiredRoleId String           @db.Uuid
  requiredRole   Role             @relation(fields: [requiredRoleId], references: [id])

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([workflowId, stepOrder])
}

// 8. Notification Templates
model NotificationTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  type         String // SMS, Email, WhatsApp
  eventName    String // ORDER_READY
  subject      String?
  bodyTemplate String  @db.Text

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([type, eventName])
}

// 9. Reason Masters
model ReasonMaster {
  id          String  @id @default(uuid()) @db.Uuid
  type        String // DAMAGE, EXPIRY, RETURN
  code        String
  description String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([type, code])
}

// 10. Payment Masters
model PaymentMethod {
  id                String  @id @default(uuid()) @db.Uuid
  code              String  @unique // CASH, UPI, CARD
  name              String
  requiresReference Boolean @default(false)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
}

// 11. Vehicle Master
model Vehicle {
  id                 String    @id @default(uuid()) @db.Uuid
  registrationNumber String    @unique
  capacity           Decimal?  @db.Decimal(10, 2)
  capacityUomId      String?   @db.Uuid
  driverName         String?
  driverPhone        String?
  insuranceExpiry    DateTime?
  status             String    @default("ACTIVE") // ACTIVE, MAINTENANCE

  dispatches Dispatch[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
}

// 12. Designation Master
model Designation {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  code           String?
  name           String?
  title          String?       @unique
  department     String?
  description    String?
  level          Int           @default(1)
  employees      Employee[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@map("Designation")
}

// 13. Dashboard Widgets
model DashboardWidget {
  id            String @id @default(uuid()) @db.Uuid
  code          String @unique // SALES, PROFIT, CRM
  title         String
  defaultLayout Json?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
}

// ────────────────────────────────────────────────────────────────────────
// SPRINT 3 : INVENTORY LEDGER CORE
// ────────────────────────────────────────────────────────────────────────

enum InventoryTransactionType {
  OPENING
  PURCHASE_RECEIPT
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION
  RESERVATION_RELEASE
  WASTAGE
  WASTAGE_REVERSAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CONVERSION_OUT
  CONVERSION_IN
}

enum StockTransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  REJECTED
  CANCELLED
}

enum WastageStatus {
  PENDING
  APPROVED
  REJECTED
}

// Inventory Transaction — Immutable Ledger (no UPDATE/DELETE ever)
model InventoryTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  variantId      String                   @db.Uuid
  batchId        String?                  @db.Uuid
  fromLocationId String?                  @db.Uuid // Null for purchase/production yield
  toLocationId   String?                  @db.Uuid // Null for sales/wastage
  quantity       Decimal                  @db.Decimal(12, 4)
  type           InventoryTransactionType
  referenceId    String?                  @db.Uuid // GRN ID, Transfer ID, Order ID, etc.
  referenceType  String? // "STOCK_TRANSFER", "WASTAGE_LOG", "ORDER_INVOICE", etc.
  notes          String?
  createdBy      String                   @db.Uuid
  createdAt      DateTime                 @default(now())

  // Relations
  variant      ProductVariant  @relation(fields: [variantId], references: [id])
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])
  fromLocation Branch?         @relation("TxFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Branch?         @relation("TxToLocation", fields: [toLocationId], references: [id])

  @@index([variantId, batchId])
  @@index([fromLocationId, toLocationId])
  @@index([createdAt])
  @@map("inventory_transaction")
}

// Stock Balance — Read cache, auto-maintained by application logic (no direct writes)
model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  locationId  String   @db.Uuid
  variantId   String   @db.Uuid
  batchId     String?  @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(12, 4)
  lastUpdated DateTime @default(now()) @updatedAt

  // Relations
  location Branch         @relation(fields: [locationId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([locationId, variantId])
  @@index([locationId])
  @@map("stock_balance")
}

model InventoryBatch {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @db.Uuid
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  batchNumber    String
  manufacturedAt DateTime?
  expiresAt      DateTime?

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, batchNumber])
  @@map("inventory_batch")
}

// Stock Transfer — Request → In Transit → Received/Rejected pipeline
model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  transferNumber String              @unique // e.g. TRF-2026-0001
  fromLocationId String              @db.Uuid
  toLocationId   String              @db.Uuid
  status         StockTransferStatus @default(REQUESTED)
  requestedBy    String              @db.Uuid
  dispatchedBy   String?             @db.Uuid
  receivedBy     String?             @db.Uuid
  notes          String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?

  fromLocation Branch              @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Branch              @relation("TransferTo", fields: [toLocationId], references: [id])
  items        StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("stock_transfer")
}

model StockTransferItem {
  id                 String         @id @default(uuid()) @db.Uuid
  transferId         String         @db.Uuid
  transfer           StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId          String         @db.Uuid
  variant            ProductVariant @relation(fields: [variantId], references: [id])
  quantityRequested  Decimal        @db.Decimal(12, 4)
  quantityDispatched Decimal?       @db.Decimal(12, 4)
  quantityReceived   Decimal?       @db.Decimal(12, 4)

  @@map("stock_transfer_item")
}

// Wastage Log — Pending → Approved/Rejected approval flow
model WastageLog {
  id            String         @id @default(uuid()) @db.Uuid
  logNumber     String         @unique // e.g. WST-2026-0001
  variantId     String         @db.Uuid
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  locationId    String         @db.Uuid
  location      Branch         @relation("WastageBranch", fields: [locationId], references: [id])
  quantity      Decimal        @db.Decimal(12, 4)
  reasonCode    String // references ReasonMaster.code
  notes         String?
  status        WastageStatus  @default(PENDING)
  loggedBy      String         @db.Uuid
  approvedBy    String?        @db.Uuid
  approvedAt    DateTime?
  rejectedAt    DateTime?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([locationId])
  @@map("wastage_log")
}

// ────────────────────────────────────────────────────────────────────────
// SPRINT 3 : PRODUCT MASTER CORE
// ────────────────────────────────────────────────────────────────────────

enum ProductType {
  STANDARD
  VARIANT_PARENT
}

enum ProductSupplyType {
  STOCKED_FINISHED_GOOD
  MAKE_TO_ORDER
  ASSEMBLED_PRODUCT
  PURCHASED_PRODUCT
  CONVERTED_PRODUCT
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           ProductType  @default(STANDARD)
  sku            String? // Only for STANDARD products
  name           String
  description    String?
  hsnCode        String?
  categoryId     String       @db.Uuid
  brandId        String?      @db.Uuid
  taxRuleId      String       @db.Uuid
  uomId          String       @db.Uuid // Base UOM
  isPerishable   Boolean      @default(true)
  shelfLifeDays  Int?
  imageUrl       String?

  category Category      @relation(fields: [categoryId], references: [id])
  brand    Brand?        @relation(fields: [brandId], references: [id])
  taxRule  TaxRule       @relation(fields: [taxRuleId], references: [id])
  baseUom  UnitOfMeasure @relation(fields: [uomId], references: [id])

  variants       ProductVariant[]
  promotions     Promotion[]
  uomConversions ProductUOM[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, sku])
  @@map("product")
}

model ProductVariant {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String
  barcode    String?
  name       String // e.g. "Black Forest Cake - 1KG"
  supplyType ProductSupplyType @default(STOCKED_FINISHED_GOOD)

  // Specific settings overrides
  reorderLevel Decimal? @db.Decimal(12, 4)

  pricing         ProductPricing?
  attributeValues ProductVariantAttribute[]

  // Backwards relations to Sprint 2.5
  supplierItems SupplierItem[]
  recipeYields  RecipeMaster[]
  recipeInputs  RecipeIngredient[]

  // Sprint 3 reverse relations
  inventoryTransactions InventoryTransaction[]
  stockBalances         StockBalance[]
  transferItems         StockTransferItem[]
  wastageLogs           WastageLog[]
  batches               InventoryBatch[]

  // Sprint 5 reverse relations
  productionOrders     ProductionOrder[]
  materialConsumptions MaterialConsumption[]

  // Sprint 6 reverse relations
  prItems  PurchaseRequisitionItem[]
  poItems  PurchaseOrderItem[]
  grnItems GoodsReceiptNoteItem[]

  // Sprint 7 reverse relations
  salesOrderItems  SalesOrderItem[]
  reservationItems InventoryReservationItem[]
  returnItems      ReturnItem[]

  // Logistics
  dispatchItems DispatchItem[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@map("product_variant")
}

model ProductPricing {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @unique @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  costPrice    Decimal @db.Decimal(12, 2)
  mrp          Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@map("product_pricing")
}

model ProductUOM {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @db.Uuid
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  uomId     String        @db.Uuid
  uom       UnitOfMeasure @relation(fields: [uomId], references: [id])

  conversionFactor Decimal @db.Decimal(10, 4) // e.g. 1 Box = 10 Pieces
  isPurchaseUom    Boolean @default(false)
  isSalesUom       Boolean @default(false)

  @@unique([productId, uomId])
  @@map("product_uom")
}

model ProductVariantAttribute {
  variantId        String @db.Uuid
  attributeValueId String @db.Uuid

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("product_variant_attribute")
}

// ────────────────────────────────────────────────────────────────────────
// SPRINT 5 : PRODUCTION & MANUFACTURING
// ────────────────────────────────────────────────────────────────────────

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                String                @id @default(uuid()) @db.Uuid
  orderNumber       String                @unique // e.g. PRD-2026-0001
  locationId        String                @db.Uuid
  variantId         String                @db.Uuid
  recipeVersionId   String                @db.Uuid
  customCakeOrderId String?               @db.Uuid
  targetQuantity    Decimal               @db.Decimal(12, 4)
  status            ProductionOrderStatus @default(PLANNED)
  notes             String?

  actualYield Decimal? @db.Decimal(12, 4)

  startDate     DateTime?
  completedDate DateTime?

  location        Branch           @relation(fields: [locationId], references: [id])
  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  recipeVersion   RecipeVersion    @relation(fields: [recipeVersionId], references: [id])
  customCakeOrder CustomCakeOrder? @relation(fields: [customCakeOrderId], references: [id])

  consumptions MaterialConsumption[]

  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([locationId])
  @@map("production_order")
}

model MaterialConsumption {
  id                String  @id @default(uuid()) @db.Uuid
  productionOrderId String  @db.Uuid
  variantId         String  @db.Uuid
  quantity          Decimal @db.Decimal(12, 4)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant  @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@map("material_consumption")
}

// ────────────────────────────────────────────────────────────────────────
// SPRINT 6 : PROCUREMENT & PURCHASE
// ────────────────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PO_ISSUED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseRequisition {
  id          String  @id @default(uuid()) @db.Uuid
  prNumber    String  @unique // e.g. PR-2026-0001
  branchId    String  @db.Uuid
  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED, PO_CREATED
  requestedBy String  @db.Uuid
  notes       String?

  branch         Branch                    @relation(fields: [branchId], references: [id])
  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  @@map("purchase_requisition")
}

model PurchaseRequisitionItem {
  id        String  @id @default(uuid()) @db.Uuid
  prId      String  @db.Uuid
  variantId String  @db.Uuid
  quantity  Decimal @db.Decimal(12, 4)
  notes     String?

  requisition PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  variant     ProductVariant      @relation(fields: [variantId], references: [id])

  @@map("purchase_requisition_item")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  poNumber    String              @unique // e.g. PO-2026-0001
  supplierId  String              @db.Uuid
  branchId    String              @db.Uuid
  prId        String?             @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @default(0) @db.Decimal(12, 2)
  notes       String?

  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  branch      Branch               @relation(fields: [branchId], references: [id])
  requisition PurchaseRequisition? @relation(fields: [prId], references: [id])

  items PurchaseOrderItem[]
  grns  GoodsReceiptNote[]

  createdBy  String    @db.Uuid
  approvedBy String?   @db.Uuid
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  poId        String  @db.Uuid
  variantId   String  @db.Uuid
  quantity    Decimal @db.Decimal(12, 4)
  receivedQty Decimal @default(0) @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  po      PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_order_item")
}

model GoodsReceiptNote {
  id              String  @id @default(uuid()) @db.Uuid
  grnNumber       String  @unique // e.g. GRN-2026-0001
  poId            String  @db.Uuid
  supplierId      String  @db.Uuid
  branchId        String  @db.Uuid
  status          String  @default("RECEIVED")
  supplierInvoice String?
  notes           String?

  po       PurchaseOrder          @relation(fields: [poId], references: [id])
  supplier Supplier               @relation(fields: [supplierId], references: [id])
  branch   Branch                 @relation(fields: [branchId], references: [id])
  items    GoodsReceiptNoteItem[]

  receivedBy String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([poId])
  @@index([supplierId])
  @@map("goods_receipt_note")
}

model GoodsReceiptNoteItem {
  id        String  @id @default(uuid()) @db.Uuid
  grnId     String  @db.Uuid
  variantId String  @db.Uuid
  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @db.Decimal(12, 2) // Extracted from PO

  grn     GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  variant ProductVariant   @relation(fields: [variantId], references: [id])

  @@map("goods_receipt_note_item")
}

// ────────────────────────────────────────────────────────────────────────
// SPRINT 7 : SALES, ORDERS & COMMERCIAL LAYER
// ────────────────────────────────────────────────────────────────────────

model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String?   @db.Uuid
  assignedBranchId String?   @db.Uuid
  assignedStaffId  String?   @db.Uuid
  phone            String    @unique
  fullName         String?
  email            String?
  birthday         DateTime?
  anniversary      DateTime?
  customerType     String    @default("RETAIL") // RETAIL, CORPORATE, WHOLESALE
  loyaltyPoints    Int       @default(0)

  // Sprint 10 Customer Intelligence & RFM fields
  healthStatus   String    @default("HEALTHY") // HEALTHY, AT_RISK, DORMANT, CHURNED
  healthScore    Int       @default(100)
  rfmRecency     Int       @default(5)
  rfmFrequency   Int       @default(5)
  rfmMonetary    Int       @default(5)
  rfmSegment     String    @default("NEW")
  lifetimeValue  Decimal   @default(0) @db.Decimal(12, 2)
  lastOrderAt    DateTime?
  lastActivityAt DateTime?

  addresses           CustomerAddress[]
  salesOrders         SalesOrder[]
  loyaltyTransactions LoyaltyTransaction[]
  promotionUsages     PromotionUsage[]
  returnRequests      ReturnRequest[]
  activities          CrmActivity[]
  segmentMappings     CustomerSegmentMapping[]
  automationRuns      CrmAutomationRun[]
  assignedBranch      Branch?                  @relation("CustomerAssignedBranch", fields: [assignedBranchId], references: [id])

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@index([organizationId])
  @@index([assignedBranchId])
  @@index([healthStatus])
  @@index([rfmSegment])
  @@map("customer")
}

model CustomerAddress {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String  @db.Uuid
  label      String // e.g. "HOME", "WORK"
  address    String
  city       String?
  state      String?
  pincode    String?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_address")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVERSAL
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid()) @db.Uuid
  customerId  String                 @db.Uuid
  orderId     String?                @db.Uuid
  referenceId String? // External campaign or order reference
  campaignId  String? // Related marketing campaign
  type        LoyaltyTransactionType
  points      Int
  notes       String?
  expiryDate  DateTime?
  reversedAt  DateTime?
  reversedBy  String?                @db.Uuid

  customer Customer    @relation(fields: [customerId], references: [id])
  order    SalesOrder? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderId, type])
  @@index([customerId])
  @@index([type])
  @@map("loyalty_transaction")
}

model CrmActivity {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  activityType String // CALL, EMAIL, WHATSAPP, NOTE, TASK, SUPPORT_TICKET, COMPLAINT
  subject      String
  description  String?
  outcome      String?
  performedBy  String?  @db.Uuid
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([activityType])
  @@map("crm_activity")
}

model CrmSegment {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  code        String  @unique // VIP, HIGH_VALUE, NEW, REPEAT, BIRTHDAY_OPPORTUNITY, INACTIVE, AT_RISK, CUSTOM_CAKE, CORPORATE
  description String?
  rulesJson   Json?

  customers CustomerSegmentMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("crm_segment")
}

model CustomerSegmentMapping {
  customerId String   @db.Uuid
  segmentId  String   @db.Uuid
  assignedAt DateTime @default(now())

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  CrmSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([customerId, segmentId])
  @@map("customer_segment_mapping")
}

model CrmAutomation {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  eventType      String // order.placed, custom_cake.quoted, customer.birthday, customer.at_risk
  conditionsJson Json? // e.g. { minOrderValue: 1000, segment: "VIP" }
  actionType     String // WHATSAPP, EMAIL, PUSH, LOYALTY_BONUS
  actionConfig   Json? // e.g. { template: "welcome_vip", points: 50 }
  isActive       Boolean @default(true)

  runs CrmAutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("crm_automation")
}

model CrmAutomationRun {
  id             String   @id @default(uuid()) @db.Uuid
  automationId   String   @db.Uuid
  customerId     String   @db.Uuid
  idempotencyKey String   @unique
  status         String   @default("SUCCESS") // SUCCESS, FAILED, SKIPPED
  executionLog   Json?
  executedAt     DateTime @default(now())

  automation CrmAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([automationId, customerId])
  @@map("crm_automation_run")
}

enum SalesChannel {
  STOREFRONT
  POS
  CUSTOM
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum SalesOrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum FulfilmentStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
}

enum PosShiftStatus {
  OPEN
  ACTIVE
  CLOSING
  CLOSED
}

model SalesOrder {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  orderNumber    String @unique // e.g. SO-2026-0001
  customerId     String @db.Uuid
  branchId       String @db.Uuid

  channel          SalesChannel     @default(STOREFRONT)
  fulfillmentType  FulfillmentType  @default(PICKUP)
  status           SalesOrderStatus @default(DRAFT)
  paymentStatus    PaymentStatus    @default(PENDING)
  fulfilmentStatus FulfilmentStatus @default(PENDING)

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("INR")

  billingAddressSnapshot  Json?
  shippingAddressSnapshot Json?

  posShiftId String?   @db.Uuid
  posShift   PosShift? @relation(fields: [posShiftId], references: [id])

  notes String?

  customer     Customer     @relation(fields: [customerId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  items               SalesOrderItem[]
  customCakeOrder     CustomCakeOrder?
  payments            Payment[]
  paymentIntents      PaymentIntent[]
  returnRequests      ReturnRequest[]
  loyaltyTransactions LoyaltyTransaction[]
  promotionUsages     PromotionUsage[]
  reservations        InventoryReservation[]

  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([customerId])
  @@index([branchId])
  @@index([posShiftId])
  @@map("sales_order")
}

model PosShift {
  id           String         @id @default(uuid()) @db.Uuid
  branchId     String         @db.Uuid
  cashierId    String         @db.Uuid
  status       PosShiftStatus @default(OPEN)
  openingCash  Decimal        @default(0) @db.Decimal(12, 2)
  expectedCash Decimal?       @db.Decimal(12, 2)
  actualCash   Decimal?       @db.Decimal(12, 2)
  variance     Decimal?       @db.Decimal(12, 2)

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  approvedBy String?   @db.Uuid
  notes      String?

  branch        Branch                 @relation(fields: [branchId], references: [id])
  cashMovements PosShiftCashMovement[]
  orders        SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, cashierId])
  @@index([status])
  @@map("pos_shift")
}

model PosShiftCashMovement {
  id        String   @id @default(uuid()) @db.Uuid
  shiftId   String   @db.Uuid
  type      String // CASH_IN, CASH_OUT
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())

