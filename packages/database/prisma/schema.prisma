  approvedAt       DateTime?
  financeExpenseId String?          @db.Uuid
  items            PayrollItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, runNumber])
  @@index([organizationId])
  @@index([status])
  @@map("payroll_run")
