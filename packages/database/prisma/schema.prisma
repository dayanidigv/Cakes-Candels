enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountCategory {
  // Assets
  CASH_AND_EQUIVALENTS
  BANK
  ACCOUNTS_RECEIVABLE
  INVENTORY_RAW_MATERIALS
  INVENTORY_WIP
  INVENTORY_FINISHED_GOODS
  FIXED_ASSETS
  ACCUMULATED_DEPRECIATION
  OTHER_CURRENT_ASSETS

  // Liabilities
  ACCOUNTS_PAYABLE
  GRN_CLEARING
  PAYROLL_PAYABLE
  STATUTORY_PAYABLE
  TAX_PAYABLE
  SHORT_TERM_LOANS
  OTHER_CURRENT_LIABILITIES

  // Equity
  OWNERS_EQUITY
  RETAINED_EARNINGS
  CURRENT_YEAR_EARNINGS

  // Revenue
  SALES_REVENUE_RETAIL
  SALES_REVENUE_CUSTOM
  SALES_RETURNS_ALLOWANCES
  OTHER_INCOME

  // Expense
  COST_OF_GOODS_SOLD
  SALARY_AND_WAGES
  OPERATING_EXPENSE_RENT
  OPERATING_EXPENSE_UTILITIES
  OPERATING_EXPENSE_MAINTENANCE
  OPERATING_EXPENSE_LOGISTICS
  INVENTORY_WASTAGE
  DEPRECIATION_EXPENSE
  FINANCE_CHARGES
  MISCELLANEOUS_EXPENSE
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model Account {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code          String
  name          String
  description   String?
  type          AccountType
  category      AccountCategory
  normalBalance BalanceType

  parentId String?   @db.Uuid
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  isPostable   Boolean @default(true)
  isSystem     Boolean @default(false)
  isActive     Boolean @default(true)
  isReconciled Boolean @default(false)

  journalLines             JournalEntryLine[]
  debitExpenses            Expense[]                @relation("ExpenseDebitAccount")
  creditExpenses           Expense[]                @relation("ExpenseCreditAccount")
  defaultExpenseCategories ExpenseCategoryMapping[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([organizationId, category])
  @@index([parentId])
  @@map("account")
}

model FiscalYear {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isClosed  Boolean  @default(false)

  periods FiscalPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("fiscal_year")
}

model FiscalPeriod {
  id           String     @id @default(uuid()) @db.Uuid
  fiscalYearId String     @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  periodNumber Int
  name         String
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  status       FiscalPeriodStatus @default(OPEN)

  closedAt DateTime?
  closedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fiscalYearId, periodNumber])
  @@index([fiscalYearId])
  @@index([status])
  @@map("fiscal_period")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  entryNumber  String
  postingDate  DateTime @db.Date
  documentDate DateTime @default(now())

  sourceModule     String // "MANUAL", "PAYROLL", "PROCUREMENT", "SALES", "POS", "EXPENSE", "INVENTORY"
  sourceEntityType String // "MANUAL_JOURNAL", "PAYROLL_RUN", "GOODS_RECEIPT_NOTE", "SALES_ORDER", "POS_SHIFT", "EXPENSE", "INVENTORY_TRANSACTION"
  sourceEntityId   String  @db.Uuid
  sourceReference  String? // Event-specific deterministic qualifier (e.g. "DEFAULT", "NET_PAY", "TAX_COMPONENT")
  referenceNumber  String?

  status      JournalEntryStatus @default(POSTED)
  description String

  totalDebit  Decimal @db.Decimal(14, 2)
  totalCredit Decimal @db.Decimal(14, 2)

  reversalEntryId String?       @unique @db.Uuid
  reversalOf      JournalEntry? @relation("JournalReversal", fields: [reversalEntryId], references: [id])
  reversedBy      JournalEntry? @relation("JournalReversal")

  lines   JournalEntryLine[]
  expense Expense?

  createdById String    @db.Uuid
  postedById  String?   @db.Uuid
  postedAt    DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, entryNumber])
  @@unique([organizationId, sourceModule, sourceEntityType, sourceEntityId, sourceReference], name: "org_source_event_unique")
  @@index([organizationId, postingDate])
  @@index([organizationId, status])
  @@index([sourceModule, sourceEntityId])
  @@map("journal_entry")
}

model JournalEntryLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  debitAmount  Decimal @default(0) @db.Decimal(14, 2)
  creditAmount Decimal @default(0) @db.Decimal(14, 2)

  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
  @@map("journal_entry_line")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum ExpensePaymentType {
  CASH
  PETTY_CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  PAYABLE_VENDOR
}

enum TaxType {
  NONE
  GST_5
  GST_12
  GST_18
  GST_28
}

model Expense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  expenseNumber String
  branchId      String @db.Uuid
  branch        Branch @relation(fields: [branchId], references: [id])

  expenseAccountId String  @db.Uuid
  expenseAccount   Account @relation("ExpenseDebitAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)

  paymentAccountId String  @db.Uuid
  paymentAccount   Account @relation("ExpenseCreditAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)

  vendorId String?   @db.Uuid
  supplier Supplier? @relation(fields: [vendorId], references: [id])

  status        ExpenseStatus      @default(DRAFT)
  paymentType   ExpensePaymentType
  expenseDate   DateTime           @db.Date
  dueDate       DateTime?          @db.Date
  invoiceNumber String?

  baseAmount  Decimal @db.Decimal(14, 2)
  taxType     TaxType @default(NONE)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)
  currency    String  @default("INR")

  description    String
  attachmentUrl  String?
  idempotencyKey String? @unique

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  submittedById   String?   @db.Uuid
  submittedAt     DateTime?
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  postedById      String?   @db.Uuid
  postedAt        DateTime?
  cancelledById   String?   @db.Uuid
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, expenseNumber])
  @@unique([organizationId, vendorId, invoiceNumber])
  @@index([organizationId, expenseDate])
  @@index([organizationId, status])
  @@index([branchId])
  @@index([expenseAccountId])
  @@index([paymentAccountId])
  @@index([journalEntryId])
  @@map("expense")
}

model ExpenseCategoryMapping {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name                    String
  code                    String
  defaultExpenseAccountId String?  @db.Uuid
  defaultExpenseAccount   Account? @relation(fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)

  defaultTaxType    TaxType @default(NONE)
  requiresApproval  Boolean @default(true)
  approvalThreshold Decimal @default(1000) @db.Decimal(14, 2)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("expense_category_mapping")
}

// ────────────────────────────────────────────────────────────────────────
// LOGISTICS — DISPATCH PIPELINE
// Added Phase 1 fix: these models were missing, causing runtime crashes.
// ────────────────────────────────────────────────────────────────────────

enum DispatchStatus {
  PACKED
  DISPATCHED
  ON_THE_WAY
  REACHED_BRANCH
  RECEIVED
  CANCELLED
}

model Dispatch {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  organization       Organization   @relation(fields: [organizationId], references: [id])
  dispatchNumber     String         @unique
  vehicleId          String?        @db.Uuid
  vehicle            Vehicle?       @relation(fields: [vehicleId], references: [id])
  driverUserId       String?        @db.Uuid
  driverUser         User?          @relation(fields: [driverUserId], references: [id])
  fromBranchId       String         @db.Uuid
  fromBranch         Branch         @relation("DispatchFrom", fields: [fromBranchId], references: [id])
  toBranchId         String         @db.Uuid
  toBranch           Branch         @relation("DispatchTo", fields: [toBranchId], references: [id])
  status             DispatchStatus @default(PACKED)
  notes              String?
  idempotencyKey     String?        @unique
  expectedDeliveryAt DateTime?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  createdById        String         @db.Uuid
  items              DispatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("dispatch")
}

model DispatchItem {
  id                 String         @id @default(uuid()) @db.Uuid
  dispatchId         String         @db.Uuid
  dispatch           Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  variantId          String         @db.Uuid
  variant            ProductVariant @relation(fields: [variantId], references: [id])
  quantityDispatched Decimal        @db.Decimal(12, 4)
  quantityReceived   Decimal?       @db.Decimal(12, 4)
  batchId            String?        @db.Uuid
  damageNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dispatch_item")
}
